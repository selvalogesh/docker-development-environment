# Copy to .env and adjust; docker compose reads .env automatically.
# Rebuild after changing build options: docker compose up -d --build

# Where projects live inside /workspaces: the "workspaces" named volume (default, fastest on
# Windows and macOS) or a host folder to bind-mount.
# WORKSPACE=E:/VSCode

# Node versions installed with nvm; the first one is the default
NODE_VERSIONS="lts/* 20"

INSTALL_PYTHON=true
INSTALL_RUST=false
INSTALL_GO=false

TZ=UTC

# Match your host user when bind-mounting on Linux (run `id -u` / `id -g`)
# USER_UID=1000
# USER_GID=1000
